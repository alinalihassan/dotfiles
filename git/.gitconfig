[user]
	email = hassanalinali@gmail.com
  name = Alin Ali Hassan
  # Should add signingKey and gpg sign
  signingKey = ""
[includeIf "gitdir:~/Developer/Work/"]
  path = "~/.dotfiles/git/.gitconfig-work"
[init]
  defaultBranch = main
[push]
  autoSetupRemote = true
[core]
  pager = bat
  excludesfile = ~/.gitignore_global
  editor = nvim
[github]
  user = alinalihassan
[hub]
	host = github.com
[gpg]
	program = gpg
[commit]
	gpgSign = false
[tag]
	forceSignAnnotated = false
[credential]
	helper = store
