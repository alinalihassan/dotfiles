{
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontLigatures": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "editor.linkedEditing": true,
  "editor.renderWhitespace": "all",
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "workbench.iconTheme": "vscode-icons", // Icon Theme
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*" // GitHub Actions
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "terminal.integrated.profiles.osx": {
    "fish": {
      "path": "/opt/homebrew/bin/fish",
      "args": [
        "-l"
      ]
    },
  },
  // Cody
  "editor.inlineSuggest.suppressSuggestions": true,
  "cody.experimental.chatPanel": false,
  "cody.experimental.newSearch": false,
  "cody.experimental.commandLenses": true,
  "terminal.integrated.defaultProfile.osx": "fish"
}