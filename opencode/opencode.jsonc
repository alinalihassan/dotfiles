{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/kimi-k2.5",
  "instructions": [".cursor/rules/*.md"],
  "mcp": {
    "commanderview": {
      "type": "remote",
      "url": "http://localhost:3000/api/mcp",
      "enabled": true,
      "oauth": {
        "scope": "openid profile email offline_access read write"
      }
    }
  }
}
